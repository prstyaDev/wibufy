// Wibufy v0.2 — typed functions and inference
koto greet(name: string) -> string {
    return "Konnichiwa, " + name
}

fn add(a: number, b: number) -> number {
    return a + b
}

senpai language: string = "Wibufy"
let user = "Developer"
let total = add(20, 22)

print(greet(user))
print(language)
print(total)
